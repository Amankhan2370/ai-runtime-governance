# LLM Provider Configuration
OPENAI_API_KEY=ADD_YOUR_OWN_OPENAI_API_KEY
ANTHROPIC_API_KEY=ADD_YOUR_OWN_ANTHROPIC_API_KEY
LLM_PROVIDER=openai

# Control Plane Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
POLICIES_PATH=config/policies.yaml

# Cost Configuration
COST_TRACKING_ENABLED=true
MAX_COST_PER_REQUEST=0.10
BUDGET_CEILING=1000.00
AUTO_DOWNGRADE_ENABLED=true

# Safety Configuration
SAFETY_CLASSIFICATION_ENABLED=true
HARD_REJECTION_ENABLED=true
RETRY_WITH_STRICT_CONSTRAINTS=true

# Routing Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
ROUTING_STRATEGY=cost_aware

# RAG Configuration
RAG_ENABLED=true
VECTOR_DB_URL=ADD_YOUR_OWN_VECTOR_DB_URL
RAG_THRESHOLD=0.7

# Evaluation Configuration
EVALUATION_ENABLED=true
HALLUCINATION_THRESHOLD=0.7
GROUNDING_THRESHOLD=0.6

# Observability
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
DECISION_LOGGING=true
